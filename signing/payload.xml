<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="lumen.exe" product-name="Lumen" product-version="${version}" original-filename="lumen.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="uninstaller/uninst-*.e*" product-name="Lumen" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
